<?xml version="1.0" encoding="utf-8"?>
<layout>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/ai_history_background"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp">


        <LinearLayout
            android:id="@+id/ai_history_contents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:orientation="horizontal">

            <TextView
                style="@style/RegularBodyExtraSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 요약" />

            <TextView
                style="@style/RegularCaptionMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:text="AI로 생성했던 노트 요약과 문제를 모아 볼 수 있습니다." />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/small_blue_button_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/buttonText"
                    style="@style/RegularCaptionMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="더보기"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ai_history_recycler_view"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blue_10"
            android:layout_marginTop="12dp"
            android:paddingVertical="16dp"
            android:paddingHorizontal="8dp"
            android:orientation="horizontal" />
    </LinearLayout>
</layout>