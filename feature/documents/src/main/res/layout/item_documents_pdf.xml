<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/size_file_width"
    android:layout_height="@dimen/size_file_height"
    android:layout_marginVertical="12dp"
    android:background="@drawable/file_item_background"
    android:elevation="4dp"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">

    <!-- 상단 색상 및 책갈피 아이콘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end"
        android:background="@drawable/default_card_background"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bookmarkIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_file_saved_inactive" />
    </LinearLayout>

    <!-- 파일 정보 텍스트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <!-- 제목 텍스트, 줄이 넘치면 '...' 표시 -->
        <TextView
            android:id="@+id/fileName"
            style="@style/RegularCaptionMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="DeepLearning (1)"
            android:textColor="@android:color/black"
            android:textStyle="bold" /> <!-- 줄이 넘치면 ... 표시 -->

        <!-- 타임스탬프 텍스트 -->
        <TextView
            android:id="@+id/fileTimestamp"
            style="@style/RegularCaptionExtraSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24.09.04.15:20"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>
</LinearLayout>