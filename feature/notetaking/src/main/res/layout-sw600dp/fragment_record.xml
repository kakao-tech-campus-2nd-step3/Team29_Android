<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.iguana.notetaking.recording.RecordViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 박스를 만들기 위한 뷰 (상단 고정) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/boxView"
            android:layout_width="180dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/page_box_background"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"> <!-- 상단 마진 추가 -->
            <!-- 박스 안에 텍스트를 표시하는 TextView -->
            <TextView
                android:id="@+id/recordPageTextView"
                style="@style/RegularCaptionExtraSmall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@{viewModel.pageNumber != null ? String.valueOf(viewModel.pageNumber + 1) + ` 페이지` : `1 페이지`}"
                android:textColor="@color/grey_20"
                app:layout_constraintBottom_toBottomOf="@id/boxView"
                app:layout_constraintEnd_toEndOf="@id/boxView"
                app:layout_constraintStart_toStartOf="@id/boxView"
                app:layout_constraintTop_toTopOf="@id/boxView" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/recordStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/is_not_recording"
            android:layout_gravity="center_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/boxView"/>

        <!-- 상태 확인 버튼을 상태 메시지 아래에 배치 -->
        <LinearLayout
            android:id="@+id/sttStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/recordStatusTextView">

            <TextView
                android:id="@+id/sttStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="@string/stt_empty_message"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <!--공백-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="8dp" />

            <LinearLayout
                android:id="@+id/sttRefreshButton"
                android:layout_width="@dimen/size_refresh_button_width"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="8dp"
                android:background="@drawable/button1_background"
                android:clickable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <!-- 아이콘 (좌측) -->
                <ImageView
                    android:id="@+id/refreshIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_refresh_white" />

                <!-- 텍스트 -->
                <TextView
                    android:id="@+id/refreshText"
                    style="@style/RegularCaptionExtraSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="서버 동기화"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:background="@drawable/stt_box_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/sttStatus"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>