<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.iguana.notetaking.ai.AiViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 박스를 만들기 위한 뷰 (상단 고정) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/boxView"
            android:layout_width="180dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/page_box_background"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"> <!-- 상단 마진 추가 -->
            <!-- 박스 안에 텍스트를 표시하는 TextView -->
            <TextView
                android:id="@+id/aiPageTextView"
                style="@style/RegularCaptionExtraSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@{viewModel.pageNumber != null ? String.valueOf(viewModel.pageNumber + 1) + ` 페이지` : `1 페이지`}"
                android:textColor="@color/grey_20"
                app:layout_constraintBottom_toBottomOf="@id/boxView"
                app:layout_constraintEnd_toEndOf="@id/boxView"
                app:layout_constraintStart_toStartOf="@id/boxView"
                app:layout_constraintTop_toTopOf="@id/boxView" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 상태 확인 버튼을 상태 메시지 아래에 배치 -->
        <LinearLayout
            android:id="@+id/aiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="150dp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/boxView">

            <TextView
                android:id="@+id/aiStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/ai_empty_message" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="8dp"/>

            <!-- 상태 확인 버튼을 상태 메시지 아래에 배치 -->
            <LinearLayout
                android:id="@+id/refreshButton"
                android:layout_width="@dimen/size_refresh_button_width"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_gravity="center_horizontal"
                android:clickable="true"
                android:background="@drawable/button1_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <!-- 아이콘 (좌측) -->
                <ImageView
                    android:id="@+id/refreshIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_refresh_white" />

                <!-- 텍스트 -->
                <TextView
                    android:id="@+id/refreshText"
                    style="@style/RegularCaptionExtraSmall"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="서버 동기화" />
            </LinearLayout>

        </LinearLayout>


        <!-- 스크롤 가능한 영역 -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="20dp"
            app:layout_constraintBottom_toTopOf="@id/aiButton"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/aiStatus">


            <!-- 요약 및 문제 결과 레이아웃 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 요약 타이틀 -->
                <TextView
                    android:id="@+id/summaryTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="요약"
                    android:textColor="@color/black"
                    style="@style/BoldBodyExtraSmall" />

                <!-- 요약 텍스트뷰 -->
                <TextView
                    android:id="@+id/aiContentTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI 요약"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone" />

                <!-- 구분선 -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/grey_50" />

                <!-- 연습문제 타이틀 -->
                <TextView
                    android:id="@+id/problemTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="연습 문제"
                    android:textColor="@color/black"
                    style="@style/BoldBodyExtraSmall" />

                <!-- 문제 결과 텍스트뷰 -->
                <TextView
                    android:id="@+id/aiProblemTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="문제 결과"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone" />
            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/aiButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/button4_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="44dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- 아이콘 (좌측) -->
            <ImageView
                android:id="@+id/buttonIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_ai_active" />

            <!-- 텍스트 (AI 요약하기) -->
            <TextView
                android:id="@+id/buttonText"
                style="@style/RegularCaptionMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="AI 요약하기" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
