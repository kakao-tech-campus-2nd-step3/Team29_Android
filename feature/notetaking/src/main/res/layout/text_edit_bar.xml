<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/text_edit_bar"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/toobar_background"
    android:gravity="center"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/edit_control_btns"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginRight="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_at_back" />

        <ImageButton
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_at_next" />
    </LinearLayout>

    <include
        android:id="@+id/ll_text_size_dropdown"
        layout="@layout/text_size_dropdown" />

    <include
        android:id="@+id/ll_text_align_dropdown"
        layout="@layout/text_align_dropdown" />

    <include
        android:id="@+id/ll_text_color_dropdown"
        layout="@layout/text_color_dropdown" />

    <include
        android:id="@+id/ll_text_format_icons"
        layout="@layout/text_format_icons" />

    <include
        android:id="@+id/ll_text_list_icons"
        layout="@layout/text_list_icons" />

</LinearLayout>