<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.iguana.notetaking.recording.RecordViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 박스를 만들기 위한 뷰 (상단 고정) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/boxView"
            android:layout_width="180dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/page_box_background"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"> <!-- 상단 마진 추가 -->
            <!-- 박스 안에 텍스트를 표시하는 TextView -->
            <TextView
                android:id="@+id/recordPageTextView"
                style="@style/Regular6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_gravity="center"
                android:text="@{String.valueOf(viewModel.pageNumber) + ` 페이지`}"
                android:textColor="@color/grey_20"
                app:layout_constraintBottom_toBottomOf="@id/boxView"
                app:layout_constraintEnd_toEndOf="@id/boxView"
                app:layout_constraintStart_toStartOf="@id/boxView"
                app:layout_constraintTop_toTopOf="@id/boxView" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/recordStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:text="@string/is_not_recording"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/boxView" />

        <!-- 스크롤 가능한 영역 -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recordStatusTextView">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recordContentTextView"
                    style="@style/Regular8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Record Content"
                    android:textColor="@color/grey_20"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>